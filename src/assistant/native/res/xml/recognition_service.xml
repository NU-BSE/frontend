<?xml version="1.0" encoding="utf-8"?>
<!--
  Metadata for AssistantRecognitionService.

  A separate file from voice_interaction_service.xml on purpose: the
  `android.speech` meta-data is parsed as a <recognition-service> element, so
  pointing it at the <voice-interaction-service> element makes the speech
  framework fail to parse the component when it enumerates recognisers.
-->
<recognition-service xmlns:android="http://schemas.android.com/apk/res/android" />
