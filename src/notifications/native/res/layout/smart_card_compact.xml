<?xml version="1.0" encoding="utf-8"?>
<!--
  Collapsed / heads-up card.

  Deliberately plain: the heads-up window is short, and the system draws its
  own chrome around this through DecoratedCustomViewStyle. Fixed text colours
  are avoided so the card follows the system's notification theme instead of
  turning invisible in dark mode.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/smart_card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

    <TextView
        android:id="@+id/smart_card_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Compat.Notification" />
</LinearLayout>
