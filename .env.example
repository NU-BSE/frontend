# Base URL of the Creepy.IM backend.
#
# `localhost` is the *device*, not your development machine. The client
# rewrites localhost/127.0.0.1 to 10.0.2.2 on Android automatically, which is
# the host loopback alias used by the Android emulator — so the value below
# works for `npm run android` against a local backend with no edits.
#
# A physical device is on neither loopback and cannot be rewritten to anything
# sensible: set your machine's LAN address explicitly, e.g.
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:8000/api
#
# Requests time out after 15s rather than hanging, and the error names the host
# that failed — if you see that message, this is the value to check first.
#
# Note that only debug builds permit cleartext http:// traffic; a release APK
# requires https.
EXPO_PUBLIC_API_URL=http://localhost:8000/api
