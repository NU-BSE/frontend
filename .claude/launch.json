{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "start",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--port",
        "8081",
        "--clear"
      ],
      "port": 8081,
      "autoPort": false
