{
  "name": "creepyim",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "workspaces": [
    "app/*",
    "packages/*",
    "modules/*"
  ],
  "dependencies": {
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo/metro-runtime": "~57.0.10",
    "@mobile-agent/approval-core": "*",
    "@mobile-agent/connector-android": "*",
    "@mobile-agent/connector-core": "*",
    "@mobile-agent/connector-discord": "*",
    "@mobile-agent/connector-dropbox": "*",
    "@mobile-agent/connector-github": "*",
    "@mobile-agent/connector-google": "*",
    "@mobile-agent/connector-intents": "*",
    "@mobile-agent/connector-microsoft": "*",
    "@mobile-agent/connector-mock": "*",
    "@mobile-agent/connector-notion": "*",
    "@mobile-agent/connector-registry": "*",
    "@mobile-agent/connector-slack": "*",
    "@mobile-agent/connector-spotify": "*",
    "@mobile-agent/connector-telegram": "*",
    "@mobile-agent/connector-todoist": "*",
    "@mobile-agent/credential-vault": "*",
    "@mobile-agent/mcp-client": "*",
    "@mobile-agent/mcp-server": "*",
    "@mobile-agent/oauth-core": "*",
    "@mobile-agent/policy-core": "*",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/ai": "^0.42.0",
    "@tanstack/ai-client": "^0.22.1",
    "@tanstack/ai-react": "^0.18.1",
    "@tanstack/react-query": "^5.101.4",
    "cheerio": "^1.2.0",
    "docx": "^9.7.1",
    "expo": "~57.0.8",
    "expo-auth-session": "~57.0.6",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.13",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "fast-xml-parser": "^5.10.1",
    "file-type": "^22.0.1",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.1",
    "llama.rn": "^0.12.9",
    "mammoth": "^1.12.1",
    "papaparse": "^5.6.0",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-iap": "^16.3.1",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-tdlib": "^2.3.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "toqr": "^0.1.1",
    "uint8array-extras": "^1.5.0",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@react-native/jest-preset": "^0.86.2",
    "@react-native/metro-config": "^0.87.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~6.0.3",
    "wrangler": "^4.114.0",
    "yoga-layout": "^3.2.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "build": "npm run build:android && npm run build:web",
    "build:android": "expo export --platform android --output-dir dist/android",
    "build:web": "expo export --platform web --output-dir dist/web",
    "typecheck": "tsc --noEmit",
    "verify:ai": "esbuild scripts/verify-ai-connection.mts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-ai.cjs --log-level=error && node node_modules/.cache/verify-ai.cjs",
    "prebuild:android": "expo prebuild --platform android",
    "lint": "expo lint",
    "verify:logic": "esbuild scripts/verify-logic.mts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-logic.cjs --log-level=error && node node_modules/.cache/verify-logic.cjs",
    "verify:layout": "esbuild scripts/verify-layout.mts --bundle --platform=node --format=esm --loader:.svg=text --external:react-native-svg --outfile=node_modules/.cache/verify-layout.mjs --log-level=error && node node_modules/.cache/verify-layout.mjs",
    "verify:device": "esbuild scripts/verify-device-selection.mts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-device-selection.cjs --log-level=error && node node_modules/.cache/verify-device-selection.cjs",
    "verify:mcp": "esbuild scripts/verify-mcp.mts --bundle --platform=node --format=cjs --external:react-native --external:expo-modules-core --external:expo-file-system --outfile=node_modules/.cache/verify-mcp.cjs --log-level=error && node node_modules/.cache/verify-mcp.cjs",
    "verify:agent": "esbuild scripts/verify-agent.mts --bundle --platform=node --format=cjs --external:react-native --external:expo-modules-core --outfile=node_modules/.cache/verify-agent.cjs --log-level=error && node node_modules/.cache/verify-agent.cjs",
    "verify:connections": "esbuild scripts/verify-connections.mts --bundle --platform=node --format=cjs --external:react-native --external:expo-modules-core --external:expo-file-system --outfile=node_modules/.cache/verify-connections.cjs --log-level=error && node node_modules/.cache/verify-connections.cjs",
    "verify:routing": "esbuild scripts/verify-agent-routing.mts --bundle --platform=node --format=cjs --external:react-native --external:expo-modules-core --outfile=node_modules/.cache/verify-agent-routing.cjs --log-level=error && node node_modules/.cache/verify-agent-routing.cjs",
    "verify:remote-agent": "esbuild scripts/verify-remote-agent.mts --bundle --platform=node --format=cjs --external:llama.rn --outfile=node_modules/.cache/verify-remote-agent.cjs --log-level=error && node node_modules/.cache/verify-remote-agent.cjs",
    "verify:telegram": "esbuild scripts/verify-telegram-tdlib.mts --bundle --platform=node --format=cjs --external:react-native --external:react-native-tdlib --outfile=node_modules/.cache/verify-telegram.cjs --log-level=error && node node_modules/.cache/verify-telegram.cjs",
    "verify:google": "esbuild scripts/verify-google.mts --bundle --platform=node --format=cjs --external:react-native --external:expo-modules-core --outfile=node_modules/.cache/verify-google.cjs --log-level=error && node node_modules/.cache/verify-google.cjs",
    "verify:gmail": "esbuild scripts/verify-gmail.mts --bundle --platform=node --format=cjs --external:react-native --external:expo-modules-core --outfile=node_modules/.cache/verify-gmail.cjs --log-level=error && node node_modules/.cache/verify-gmail.cjs",
    "verify:attachments": "esbuild scripts/verify-attachments.mts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-attachments.cjs --log-level=error && node node_modules/.cache/verify-attachments.cjs",
    "verify:content-engine": "esbuild scripts/verify-content-engine.mts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-content-engine.cjs --log-level=error && node node_modules/.cache/verify-content-engine.cjs",
    "verify:content-engine:xlsx": "esbuild scripts/verify-content-engine-xlsx.mts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-content-engine-xlsx.cjs --log-level=error && node node_modules/.cache/verify-content-engine-xlsx.cjs",
    "verify": "npm run verify:ignored && npm run typecheck && npm run lint && npm run verify:ai && npm run verify:logic && npm run verify:layout && npm run verify:device && npm run verify:mcp && npm run verify:prompt-intent && npm run verify:agent && npm run verify:connections && npm run verify:routing && npm run verify:remote-agent && npm run verify:telegram && npm run verify:google && npm run verify:gmail && npm run verify:markdown && npm run verify:attachments && npm run verify:prediction && npm run verify:formats && npm run verify:content-engine && npm run verify:content-engine:xlsx && npm run verify:custom-mcp && npm run verify:sandbox && npm run verify:model-install && npm run verify:resolver",
    "deploy": "node deploy.js",
    "preview": "npx expo export --platform web && wrangler dev",
    "verify:prediction": "esbuild scripts/verify-prediction.mts --bundle --platform=node --format=cjs --external:react-native --outfile=node_modules/.cache/verify-prediction.cjs --log-level=error && node node_modules/.cache/verify-prediction.cjs",
    "verify:ignored": "esbuild scripts/verify-ignored-sources.mts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-ignored.cjs --log-level=error && node node_modules/.cache/verify-ignored.cjs",
    "verify:markdown": "esbuild scripts/verify-inline-markdown.mts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-markdown.cjs --log-level=error && node node_modules/.cache/verify-markdown.cjs",
    "verify:formats": "esbuild scripts/verify-format-adapters.mts --bundle --platform=node --format=cjs --external:react-native --external:expo-file-system --outfile=node_modules/.cache/verify-formats.cjs --log-level=error && node node_modules/.cache/verify-formats.cjs",
    "verify:prompt-intent": "esbuild scripts/verify-prompt-intent.mts --bundle --platform=node --format=cjs --external:react-native --outfile=node_modules/.cache/verify-prompt-intent.cjs --log-level=error && node node_modules/.cache/verify-prompt-intent.cjs",
    "verify:resolver": "esbuild scripts/verify-resolver.mts --bundle --platform=node --format=cjs --external:@modelcontextprotocol/client --external:@modelcontextprotocol/client/stdio --external:@modelcontextprotocol/server --external:@modelcontextprotocol/server/stdio --external:zod --outfile=node_modules/.cache/verify-resolver.cjs --log-level=error && node node_modules/.cache/verify-resolver.cjs",
    "build:resolver": "cd resolver && ./gradlew installDist fatJar",
    "verify:custom-mcp": "esbuild scripts/verify-custom-mcp.mts --bundle --platform=node --format=cjs --alias:@react-native-async-storage/async-storage=./scripts/stubs/async-storage.mts --alias:@/mcp/runtime-singleton=./scripts/stubs/runtime-singleton.mts --alias:expo-secure-store=./scripts/stubs/expo-secure-store.mts --alias:expo-crypto=./scripts/stubs/expo-crypto.mts --alias:react-native=./scripts/stubs/react-native.mts --external:expo-file-system --outfile=node_modules/.cache/verify-custom-mcp.cjs --log-level=error && node node_modules/.cache/verify-custom-mcp.cjs",
    "verify:sandbox": "esbuild scripts/verify-sandbox.mts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-sandbox.cjs --log-level=error && node node_modules/.cache/verify-sandbox.cjs",
    "verify:model-install": "esbuild scripts/verify-model-install.mts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-model-install.cjs --log-level=error && node node_modules/.cache/verify-model-install.cjs"
  },
  "private": true
}
