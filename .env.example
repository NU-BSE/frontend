# Base URL (origin only) of the Creepy.IM backend.
#
# NO PATH SUFFIX. The FastAPI backend mounts its routers at the root — /auth,
# /users, /subscriptions, /admin — with no /api prefix anywhere. Appending
# `/api` here makes every request 404.
#
# Deployed backend:
#   EXPO_PUBLIC_API_URL=https://api.creepy.im
#
# ALWAYS https for a remote host. Plain http:// to a host behind Cloudflare
# gets a 301 to https, and following a 301 turns a POST into a GET — so
# /auth/email/request-code comes back "405 Method Not Allowed" and looks like a
# broken backend rather than a broken URL. Release APKs block cleartext http
# outright, so https is required there regardless.
#
# Local backend (`make dev` in ../backend, uvicorn on :8000):
#   EXPO_PUBLIC_API_URL=http://localhost:8000
#
# `localhost` is the *device*, not your development machine. The client rewrites
# localhost/127.0.0.1 to 10.0.2.2 on Android automatically — the host loopback
# alias used by the emulator — so the local value above works for
# `npm run android` with no edits. A physical device is on neither loopback and
# cannot be rewritten to anything sensible: set your machine's LAN address
# explicitly, e.g. http://192.168.1.42:8000
#
# Requests time out after 15s rather than hanging, and the error names the host
# that failed — if you see that message, this is the value to check first.
EXPO_PUBLIC_API_URL=https://api.creepy.im

# --- Telegram TDLib adapter ---------------------------------------------
#
# Which adapter to use for the Telegram personal-account connector:
#   mock   — deterministic in-memory double (default in development).
#   native — react-native-tdlib bridge (default in production).
#
# Set to "native" in development to test real TDLib auth/messaging while
# keeping all other connectors in mock mode.
EXPO_PUBLIC_TELEGRAM_ADAPTER=mock
#
# Telegram API credentials (required for native adapter).
EXPO_PUBLIC_TELEGRAM_API_ID=
EXPO_PUBLIC_TELEGRAM_API_HASH=
#
# MCP runtime mode:
#   development — mock connectors, development tools (default when __DEV__).
#   production  — real connectors only, no mock accounts.
EXPO_PUBLIC_MCP_RUNTIME_MODE=development

# --- Local LLM / engine selection (all optional) -------------------------
#
# Force a specific engine regardless of device assessment:
#   on-device | remote | stub   (empty = auto-select)
#EXPO_PUBLIC_LLM_ENGINE=
#
# Path (on the device) of the GGUF model for on-device inference. Without it,
# the app degrades to the offline preview with a visible reason.
#EXPO_PUBLIC_LLM_MODEL_PATH=
#
# Per-profile overrides (efficient / balanced / performance memory profiles):
#EXPO_PUBLIC_LLM_MODEL_EFFICIENT_PATH=
#EXPO_PUBLIC_LLM_MODEL_BALANCED_PATH=
#EXPO_PUBLIC_LLM_MODEL_PERFORMANCE_PATH=

# --- Remote Agent Chat ----------------------------------------------------
#
# The canonical Creepy.IM backend origin. Used by the remote Agent Chat:
# the AgentRuntime POSTs to {EXPO_PUBLIC_API_URL}/agent/step (full
# tool-calling contract — the backend plans tool calls, the app executes them
# locally through MCP).
#
# Selecting the "cloud" memory profile (or EXPO_PUBLIC_LLM_ENGINE=remote)
# enables remote inference as soon as this value is set. It is NOT tied to
# EXPO_PUBLIC_TANSTACK_AI_BASE_URL above.
#
#   EXPO_PUBLIC_API_URL=https://api.creepy.im
#
# Local backend (`make dev` in ../backend, uvicorn on :8000):
#   EXPO_PUBLIC_API_URL=http://localhost:8000
#
# `localhost` means the device, not the development machine — the client
# rewrites it to 10.0.2.2 on the Android emulator automatically.
EXPO_PUBLIC_API_URL=https://api.creepy.im

# Optional legacy text-stream endpoint (TanStack AI `useChat` HTTP stream).
# NOT required for AgentRuntime → /agent/step.
#EXPO_PUBLIC_TANSTACK_AI_BASE_URL=

# --- Google connector sign-in ----------------------------------------------
#
# Google sign-in uses Google Play Services `AuthorizationClient` (Google
# Identity). The app is authenticated by its package name (im.creepy.app) plus
# the signing certificate's SHA-1 registered in the Google Cloud console.
#
# There is NO OAuth client id or client secret in the app, NO redirect scheme
# in the manifest, and NO refresh token stored on the device. The connector
# requests short-lived access tokens on demand for the read-only Calendar and
# Drive scopes only.
#
# The certificate SHA-1 is only needed when registering the Android client in
# the console — the app never reads it. A name containing a hyphen
# (EXPO_PUBLIC_SHA-1) is unreadable from JavaScript anyway: it parses as a
# subtraction, and Expo only inlines dot-accessible names.
