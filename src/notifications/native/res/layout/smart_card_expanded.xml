<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded card.

  Same ids as the collapsed layout so one builder fills both. The detail line
  is GONE by default and shown only when the card carries one — an empty
  TextView would still take vertical space and leave a visible gap.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/smart_card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

    <TextView
        android:id="@+id/smart_card_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="5"
        android:textAppearance="@style/TextAppearance.Compat.Notification" />

    <TextView
        android:id="@+id/smart_card_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:visibility="gone"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />
</LinearLayout>
